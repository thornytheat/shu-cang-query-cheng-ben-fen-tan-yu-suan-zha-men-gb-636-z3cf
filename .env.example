# 容器内数据库路径（挂载命名卷 costsplit-data）
COSTSPLIT_DB=/data/costsplit.sqlite
# 样例目录：容器内 /app/sample_data，本地直接运行时用 ./sample_data
COSTSPLIT_SAMPLE_DIR=./sample_data
# 默认导入的样例文件名（必须是样例目录下的 csv）
COSTSPLIT_SOURCE=bills_2026_11_dirty.csv
# 默认预算表文件名
COSTSPLIT_BUDGET_SOURCE=budgets.csv
# 评估日：批次号按此日期编号，固定后结果可复算
EVAL_DATE=2026-11-15
